# Copy to .env (ignored by Git) and fill in. Never commit real values.

# OpenAI API key of the dedicated RayGPT project.
OPENAI_API_KEY=

# Shared secret for the iPhone app and the web test client, at least 32 characters.
# Generate one with: openssl rand -hex 32
APP_TOKEN=

# Optional settings (defaults shown).
OPENAI_MODEL=gpt-live-1
OPENAI_VOICE=marin
MAX_SESSIONS_PER_DAY=50
PORT=8787

# Only for Strada C (phone calls over SIP).
# Signing secret of the OpenAI webhook endpoint (whsec_...).
OPENAI_WEBHOOK_SECRET=
# Comma-separated E.164 numbers allowed to call, e.g. +393331234567
SIP_CALLER_ALLOWLIST=
